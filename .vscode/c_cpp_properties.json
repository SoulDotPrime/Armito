{
    "configurations": [
        {
            "name": "Armito-EDK2",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:HOME}/edk2/**"
            ],
            "defines": [
                "MDE_CPU_X64"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "path": [
                    "${workspaceFolder}/**",
                    "${env:HOME}/edk2/**"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}